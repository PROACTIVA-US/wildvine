# Wildvine gateway — Podman Quadlet (rootless)
# Installed by setup-podman.sh into wildvine's ~/.config/containers/systemd/
# {{WILDVINE_HOME}} is replaced at install time.

[Unit]
Description=Wildvine gateway (rootless Podman)

[Container]
Image=wildvine:local
ContainerName=wildvine
UserNS=keep-id
Volume={{WILDVINE_HOME}}/.wildvine:/home/node/.wildvine
EnvironmentFile={{WILDVINE_HOME}}/.wildvine/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
